[Unit]
Description=DartLink public contact SMTP bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dartlink-contact
Group=dartlink-contact
EnvironmentFile=/home/admin/.config/dartlink-contact/env
ExecStart=/usr/bin/python3 /opt/dartlink-contact/contact-server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
